{
	// WIDGET SETTINGS
	"x": 5,
	"y": 100,
	"anchor": "top", // top, bottom
	"ySpacing": -3,
	"width": 300,
	"textSize": 17,
	// Some of the working fonts:
	//	"$76HandwrittenNeat_Font", "$76HandwrittenIlliterate", "$Adventure_Font", "$BerlinDemi", "$BRODY",
	//	"$Brush_Script_Std", "$ChowderHead", "$ConsoleFont", "$DebugTextFont", "$DotMatrix_Font", "$evaScript_Font",
	//	"$Futura_Bold", "$Futura_Bold_Oblique", "$Futura_Medium_Oblique", "$HandwrittenFont", "$KiddieCocktails",
	//	"$Leiascript_Font", "$MAIN_Font", "$MAIN_Font_Bold", "$NixieTube_Font",
	//	"$Portico_Font_Regular", "$Slate_Mobile", "$Terminal_Font", "$Typewriter_Font"
	"textFont": "$MAIN_Font_Bold",
	"textAlign": "left", // left, center, right
	"textColor": "0xffffff",
	"textShadow": true,
	"background": false,
	"backgroundColor": "0x222222",
	// alpha / backgroundAlpha:
	//	0 = loads default value
	//	0.0001 = transparent
	//	0.0 < value < 1.0 = semi-transparent
	//	1.0 = opaque
	// HUD Opacity in settings can be changed so value of "alpha" can go over 1.0 (does not apply to "backgroundAlpha")
	"alpha": 1.0,
	"backgroundAlpha": 0.5,
	
	"disableRealTimeEdit": false,
	
	"prioritizeHUDToolsSyncOverSFE": false, // HUDMODLOADER ONLY, DO NOT ENABLE THIS IF YOUR WIDGET IS LOADED IN OVERLAY LAYER - IT WILL STOP WORKING
	
	
	// PIPBOY SETTINGS
	"showAllPipboyTabs": true,
	"showAllPipboyTabsFormat": "autoSize", // autoSize, fixedSize - 1.5.1
	"pipInventoryTabNames": [
		"$InventoryCategoryNew",
		"WPN", // "$InventoryCategoryWeapons",
		"$InventoryCategoryArmor",
		"APRL", // "$InventoryCategoryApparel",
		"FD/DR", // "$InventoryCategoryFoodWater",
		"$InventoryCategoryAid",
		"$InventoryCategoryMisc",
		"$InventoryCategoryHolo",
		"$InventoryCategoryNotes",
		"$InventoryCategoryJunk",
		"$InventoryCategoryMods",
		"$InventoryCategoryAmmo"
	],
	"quickEffectsTabHotkey": 192,
	
	
	// OVERLAY MOD LOADER ONLY SETTINGS
	"debugKeys": false,
	"toggleVisibilityHotkey": 0,
	"forceHideHotkey": "N-",
	"toggleChecklistHotkey": "N+",
	
	
	// EFFECT DISPLAY SETTINGS
	"refresh": 1000,
	
	"hidePermanentEffects": false,
	
	"hideEffectsAboveDuration": 0,
	"hideEffectsBelowDuration": -15,
	"warningBelowDuration": 30,
	
	"showSubEffects": false,
	"showExpiredSubEffects": false,
	"shownSubEffects": [
	
	],
	"hideSubEffects": [
	
	],
	"hideSubEffectsFor": [
		"MUTATION",
		"hydrated",
		"fed",
		"nerd rage",
		"team bonus"
	],
	
	
	// Types options: ALCOHOL, CHEMS, FOOD, DRINKTEA, HUNGER, MUTATION, THRIST - yes, it's a typo
	"hideTypes": [
		"MUTATION",
		"HUNGER",
		"THRIST"
	],
	"showTypes": [
		"ALCOHOL",
		"FOOD",
		"DRINKTEA",
		"DRINKGENERIC"
	],
	
	"hideEffectsState": "hidden", // hidden, shown
	"hideEffects": [
		"overencumbered",
		"team",
		"scout",
		"so much cake",
		"gift bag",
		"to-go punch",
		"noisemaker",
		"antacids",
		"plastic animals",
		"confetti mess",
		"fingertrap",
		"explosive damage",
		"stealth move",
		"stimpak",
		"life giver",
		"polished",
		"local practitioner",
		"spiritual healer",
		"chameleon",
		"vanguard",
		"power armor"
	],
	
	"debuffs": [
		"radaway", "addiction",
		"the blight", "blood worms", "bone worms", "buzz brain", "dysentery", "fever claw", "flap limb", "glowing pustules", "heat flashes", "jelly fingers", "lock joint", "needle spine", "parasites", "rad worms", "rattle hands", "shell shock", "sludge lung", "snot ear", "swamp gas", "swamp itch", "weeping sores", "the woopsies"
	],
	
	"checklistHiddenByDefault": false, // 1.4.10
	"checklistCompareMode": "contains", // starts, exact, contains
	"checklist": [
		["Int food", "Brain Bombs", "brain fungus soup", "Broiled Scorchbeast Brain"],
		["XP food", "Cranberry Relish", "Cranberry Cobbler", "Tasty Squirrel Stew", "Canned Meat Stew"],
		["Rested", "well rested", "kindred spirit", "lover's embrace"],
		"Wisdom of the Mothman",
		"Intelligence Boost",
		"Bobblehead: Leader",
		"Live & Love 8",
		"Berry Mentats"
	],
	
	"durationBar": {
		"enabled": true,
		"alignVertical": "bottom", // top, center, bottom
		"alignHorizontal": "left", // left, center, right
		"height": 3,
		"maxDuration": 1200
	},
	
	"xpBar": {
		"enabled": true,
		//text accepts: {text}, {progress}, {lastChangeValue}, {currentLevel}, {currentValue}, {thresholdValue}
		"text": "{text} [{currentLevel}] {currentValue}/{thresholdValue} {progress}% ({lastChangeValue})",
		"alignVertical": "center", // top, center, bottom
		"alignHorizontal": "left", // left, center, right
		"height": 20
	},
	
	"scoreBar": {
		"enabled": true,
		//text accepts: {progress}, {currentValue}, {thresholdValue}, {currentRank}, {currentBoost}
		"text": "SCORE [{currentRank}] {currentValue}/{thresholdValue} +{currentBoost}%",
		"alignVertical": "center", // top, center, bottom
		"alignHorizontal": "left", // left, center, right
		"height": 20
	},
	
	
	// Format accepts:
	//	{text}, {type}, {duration}, {subEffects} 
	//	example: "{duration} {text}"
	//	example for in-line subeffects:
	//		"{duration} {text} {subEffects}"
	//		works best with similar subeffect format: "subEffect": "|{text}"
	//		and filtering effects with shownSubEffects or hideSubEffects
	
	// formats options:
	//	subEffect, accepts {text}, {duration}
	//	expiredBuff, accepts {text}, {time}, {timeInSeconds}, {timeInMinutes}
	//	checklist, accepts {text}
	//	showRaidXP, accepts {xp}
		
	//	1.5.0:
	//	showHUDMode, accepts {HUDMode}
	//	showRenderTime, showElapsedTime, showLastUpdate, showLastConfigUpdate, showLastDataProcessTime, showTime12, showTime24 - accept {time}
	//	timeLong, accepts {d}, {h}, {m}, {s}
	//	timeMid, accepts {h}, {m}, {s}
	//	timeShort, accepts {m}, {s}
	"format": "{duration} | {text}",
	"formats": {
		"subEffect": "   {text}",
		"expiredBuff": "   Expired | {text} ({timeInMinutes}m)",
		"checklist": "   Missing | {text}",
		"showRaidXP": "Raid XP: {xp}",
		
		"showHUDMode": "HUDMode: {HUDMode}",
		"showRenderTime": "RenderTime: {time}ms",
		"showElapsedTime": "ElapsedTime: {time}",
		"showLastUpdate": "LastUpdate: {time} ago",
		"showLastConfigUpdate": "ConfigUpdated: {time} ago",
		"showLastDataProcessTime": "DataProcessing: {time}ms",
		"showTime12": "Time: {time}",
		"showTime24": "Time: {time}",
		
		"timeLong": "{d}d {h}:{m}:{s}",
		"timeMid": "{h}:{m}:{s}",
		"timeShort": "      {m}:{s}",
		"timeNone": "\t ∞"
	},
	
	"sortBy": "property",
	// Options: default, custom, property
	//	default: doesn't use sortOrder, lists effects same as in pipboy
	//	custom: list effect names or types which will be shown on top (in order)
	//		example: [cranberry relish", "brain bombs", "FOOD", "DRINK" ]
	//	property: list property name(s) to sort by
	//		options: "type", "text", "durationRemaining"
	//		example: ["durationRemaining", "text"] - first sort by durationRemaining then by text
	"sortOrder": [
		"durationRemaining",
		"text"
	],
	"reverseSort": false, // ascending <=> descending
	
	
	// Display data options:
	//	"showVersion" - mod version
	//	"showHUDMode" - current HUD Mode, turn it on if you want to hide widget on some screen, use displayed name in "HUDModes" below
	//	"showRenderTime" - time in milliseconds it took to redraw widget
	//	"showLastUpdate" - last time when pipboy was open and effects were updated
	//	"showLastConfigUpdate" - last time when config was reloaded (either on server join or config file changed)
	//	"showElapsedTime" - elapsed time on server
	//	"showLastExpiredBuff" - last expired buff, can be listed n times to show last n expired buffs
	//	"showTime12" - current PC time in 12-hour format, e.g. 5:05 PM
	//	"showTime24" - current PC time in 24-hour format, e.g. 17:05
	//	"text:color:text to display" - color can also be specified as any customColors value
	//		examples: "text:0xffffff:My custom text", "text:warning:Custom text 2"
	//	"showChecklist" - show effects from "checklist" field if they are not active
	//	"showLastDataProcessTime" - show processing time for effects saved in file
	//	"showXPBar" - show xp bar showing progress to next level
	//	"showScoreBar" - show SCORE bar showing progress to next rank
	//	"showRaidXP" - shows xp gained from last completed raid stage
	
	//	"showBuffs" - show buffs on that place, allowing you to choose what appears above and below it
	//		If not specified, buffs will be appended to the bottom or displayData
		
	// Data will show in order in which it is listed here, remove anything unnecessary:
	"displayData": [
		"showVersion",
		"showHUDMode",
		"showTime24",
		"showBuffs",
		//"showLastExpiredBuff",
		//"showLastExpiredBuff",
		//"showLastExpiredBuff",
		//"showRenderTime",
		//"showLastUpdate",
		//"showLastConfigUpdate",
		//"showChecklist"
	],
	
	// Custom color options:
	//	warning - effect color when duration is below warningBelowDuration
	//	expired - effect color when it expires, before it is removed
	//	durationBar - default duration bar color
	//	durationBarWarning - duration bar color when duration is below warningBelowDuration
	//	showLastExpiredBuffN - e.g. showLastExpiredBuff1 is last expired buff, showLastExpiredBuff2 is 2nd last...
	//	debuffs - custom color for debuffs
	//	xpBar - default xp bar color
	//	scoreBar - default score bar color
	//	All options from displayData
	"customColors": {
		"warning": "0xffff33",
		"expired": "0xff3377",
		"durationBar": "0x007700",
		"durationBarWarning": "0x990099",
		"showVersion": "0xff2222",
		"showHUDMode": "0xffffff",
		"showLastUpdate": "0xffaacc",
		"showLastConfigUpdate": "0x77eeff",
		"showElapsedTime": "0xaaaaff",
		"showLastExpiredBuff1": "0xff8800",
		"showLastExpiredBuff2": "0xffaa00",
		"showLastExpiredBuff3": "0xffcc00",
		"showRenderTime": "0x55ff55",
		"showTime12": "0x99ff99",
		"showTime24": "0x99ff99",
		"debuffs": "0xff0000",
		"showChecklist": "0xf7a0b5",
		"showXPBar": "0x99ff99",
		"xpBar": "0x009900",
		"showScoreBar": "0xffffff",
		"scoreBar": "0x0066ff",
		"showRaidXP": "0x99ff99"
	},
	"customEffectColors": {
		"double xp": "0x55ff55",
		"cranberry relish": "0x5acff7",
		"brain ": "0x5acff7",
		"berry mentats": "0x5acff7",
		
		"glowing bobblehead": "0xcc33ff",
		"bobblehead": "0xccaaff",
		"live & love": "0xccaaff",
		
		"very well rested": "0xffb300",
		"well rested": "0x5acff7",
		"kindred spirit": "0x5acff7",
		"lover's embrace": "0x5acff7",
		
		"boost": "0xffaa77",
		"wisdom of the mothman": "0xffaa77",
		"intelligence": "0xccaaff",
		"serum": "0xccff99"
	},
	"customChecklistColors": {
		// example: "Rested": "0xff0000",
	},
	"customSubEffectColors": {
		// example: "+5 INT": "0x99ff99",
	},
	
	// HUD Modes:
	//	"ActivateTypeMode", "All", "AutoVanity", "CampPlacement", "ContainerMode", "CrosshairAndActivateOnly",
	//	"DeathRespawnMode", "DialogueMode", "EndOfMatch", "FurnitureEnterExit", "InsideMemory", "InspectMode",
	//	"IronSights", "LegendaryPerksMode", "LockpickingMode", "MapMenu", 	"MessageMode", "MovementDisabled",
	//	"NoHud", "PauseMode", "PerksMode", "Pipboy", "PowerArmor", 	"RadialMenu", "SelfieMode", "SitWaitMode",
	//	"SpectatorMode", "TerminalMode", "VATS", "VATSPlayback", "VertibirdMode", "WorkshopMode"
	//	"Fishing"
	//	"WorkshopNoCrosshairMode"
	//	"DefaultScopeMenu", "CameraScopeMenu"
	//	"ExamineConfirmMode"
	//	"Loading", "MainMenu"
	
	//"All" is default HUD mode (non-power armor), not all of them
	"HUDModesState": "hidden", // hidden, shown
	"HUDModes": [
		"ContainerMode",
		"DialogueMode",
		"ExamineConfirmMode",
		"LegendaryPerksMode",
		"MapMenu",
		"MessageMode",
		"PauseMode",
		"PerksMode",
		//"Pipboy",
		"RadialMenu",
		"SelfieMode",
		"WorkshopMode"
	]
}