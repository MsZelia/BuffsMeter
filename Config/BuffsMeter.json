		"debuffs": "0xff0000",
		"showChecklist": "0xf7a0b5",
		"showXPBar": "0x99ff99",
		"xpBar": "0x009900",
		"showPetXPBar": "0xffffcb",
		"petXpBar": "0xffffcb",
		"showScoreBar": "0xffffff",
		"scoreBar": "0x0066ff",
		"showRaidXP": "0x99ff99"
